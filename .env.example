# 자람마을 백엔드 환경변수

# 필수 — Anthropic API 키. 없으면 모든 AI 경로가 규칙 기반 폴백으로 동작한다
# (단 마음극장 대본은 폴백 없이 실패를 정직하게 알린다).
ANTHROPIC_API_KEY=

# 사용할 모델. 비우면 아래 기본값을 쓴다.
ANTHROPIC_MODEL=claude-sonnet-5

# CORS 허용 출처. 쉼표로 구분. 절대 * 로 두지 않는다.
CORS_ORIGINS=http://localhost:5173

# 아이 발화 기본 보관기간(일). 만료 건은 접근 시 자동 파기.
DATA_RETENTION_DAYS=90

# --- 생각 친구 대화 엔진 · 첫 탐구(OpenAI) ------------------------------------
# 없으면 모든 대화가 규칙 기반 대사로 동작한다(응답 ai=false).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# 비우면 모델 기본값. 지연이 길면 low 등으로 조정한다.
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_S=20
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_REALTIME_MODEL=gpt-live-transcribe
OPENAI_MODERATION_MODEL=omni-moderation-latest

# demo: ZDR 승인 전. 실제 아동의 문장·음성은 OpenAI 로 보내지 않는다(성인 테스터 계정만 AI 사용).
# child: OpenAI Zero Data Retention 승인 뒤에만 켠다.
CHILD_DATA_MODE=demo

# 즉시 차단 스위치
AI_ENABLED=true
SPEECH_ENABLED=true

# 아이별 하루 AI 호출 한도, 한 이야기 필수 대화 시간(초)
DAILY_AI_CALL_LIMIT=300
TALK_MIN_SECONDS=900

# 저장소. 비우면 ./data/thinkforest.db(SQLite). 운영은 PostgreSQL 주소.
DATABASE_URL=

# --- JJCP API v1 (/api/v1) 인증 ---
# 카카오 앱 키는 서버에만 둔다. 비우면 카카오 로그인 API 는 503.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 웹: https://<프론트 도메인>/api/v1/auth/kakao/callback (Netlify 프록시로 같은 출처 쿠키)
KAKAO_REDIRECT_URI=
# 모바일 토큰 검증용(운영 필수)
KAKAO_APP_ID=
# 로그인 뒤 돌아갈 프론트 주소. 같은 출처 프록시면 비운다.
FRONTEND_BASE_URL=
# 개발·시연용 로그인(성인 테스터). 운영은 false.
AUTH_DEV_LOGIN=false
# 로컬 http 에서 refresh 쿠키를 쓰려면 false
AUTH_COOKIE_SECURE=true

# --- JJCP API v1 이야기 완료 기준 ---
CONVERSATION_MIN_RESPONSES=6
CONVERSATION_MIN_SECONDS=300

# --- JJCP API v1 운영자 (B3 트랙도 같은 키를 쓴다 — 이름을 바꾸지 말 것) ---
# /api/v1/admin/... 을 쓸 수 있는 카카오 회원번호. 쉼표로 나눠 적는다. 비우면 아무도 못 쓴다.
ADMIN_KAKAO_IDS=

# --- JJCP API v1 공유·커뮤니티·리포트 ---
# 운영자 카카오 회원번호(쉼표 구분). 비어 있으면 /admin/* 을 아무도 쓸 수 없다.
ADMIN_KAKAO_IDS=
# 친구 이야기 신고가 이 수에 닿으면 자동으로 숨긴다.
COMMUNITY_REPORT_HIDE_THRESHOLD=3
# 보호자 월간 상담을 만들 수 있게 되는 최소 일수.
CONSULTATION_MIN_DAYS=30
